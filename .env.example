# =============================================================================
# aaa-notifier — .env.notifier 템플릿
# =============================================================================
#
# 이 파일은 notifier 서비스 전용 환경 변수 템플릿이다.
# 프로덕션 배포 시 ${AAA_SSD_BASE}/secrets/.env.notifier 로 복사하여 값을 채운다.
#
# 인프라 공통 변수(REDIS_HOST, REDIS_PORT, REDIS_APPUSER_PASSWORD, MYSQL_HOST,
# MYSQL_PORT, MYSQL_DATABASE 등)는 .env.common에서 제공되므로 이 파일에
# 포함하지 않는다. (ADR-006 참조)
#
# 보안:
#   chmod 600 ${AAA_SSD_BASE}/secrets/.env.notifier
#
# =============================================================================


# -----------------------------------------------------------------------------
# Notifier DB 계정 (런타임 SELECT + notification_log INSERT, SPEC-NOTIFIER-SCHEMA-001)
# -----------------------------------------------------------------------------

# .env.mysql의 MYSQL_NOTIFIER_PASSWORD와 반드시 동일한 값이어야 한다
MYSQL_NOTIFIER_PASSWORD=<openssl rand -hex 24>


# -----------------------------------------------------------------------------
# 텔레그램 매매봇 (SPEC-NOTIFIER-TELEGRAM-001)
# -----------------------------------------------------------------------------

# 실발송 모드. 기본 false = 드라이런 관문 — 꺼져 있으면 필터 결정은 notification_log DRYRUN 행으로만
# 남고 텔레그램·대기 큐·safe_mode·stream:alert 어디에도 손대지 않는다. 드라이런 검토를 마친 뒤 운영자가 true로 바꾼다.
NOTIFIER_TELEGRAM_ENABLED=false

# 시스템봇(@aaa_notifier_bot)과 별개의 매매 신호 발송 전용 봇 토큰·수신 chat_id(운영자 1:1 DM).
# NOTIFIER_TELEGRAM_ENABLED=true인데 둘 중 하나라도 비어 있으면 기동이 실패한다(누락된 설정 이름만 출력, 값 비노출).
# 토큰은 로그·DB·stream:alert 어디에도 원문으로 남지 않는다(앞 4자 외 마스킹).
TELEGRAM_TRADE_BOT_TOKEN=<bot-token>
TELEGRAM_TRADE_CHAT_ID=<chat-id>

# 운영자 kill switch (Redis — 이 파일의 설정이 아니다, 재기동 불요):
#   켜기:  SET safe_mode:notifier:telegram ON   → 발송 대신 DRYRUN 기록만, 해제 후 재전달·요약 없음
#   끄기:  SET safe_mode:notifier:telegram OFF  (또는 DEL)
#   ON/OFF 외 값(1·true·빈 문자열 등)은 ON으로 간주된다(WARN 로그). 연속 실패 시 notifier가 스스로 AUTO를 기록하고
#   getMe 프로브 성공 시 스스로 해제한다 — AUTO는 운영자가 쓰는 값이 아니다.


# -----------------------------------------------------------------------------
# 현재 스캐폴딩 단계 안내
# -----------------------------------------------------------------------------
#
# SPEC-NOTIFIER-FOUNDATION-001/SCHEMA-001 완료 시점 기준, notifier 자체 빌드는
# JPA/MySQL 커넥터/Flyway/DataSource 의존성을 갖지 않는다 — 실제 DB 접속 코드는
# TELEGRAM-001(notification_log INSERT)/FILTER-001(daily_ohlcv·stocks 참조 SELECT)에서
# 추가될 예정이다(REQ-NOTIFIER-SCHEMA-041). docker-compose.yml notifier 서비스 블록도
# 아직 이 파일을 env_file로 배선하지 않는다 — 그 시점까지 이연한다.
